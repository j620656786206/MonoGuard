{
  "name": "@monoguard/monorepo",
  "version": "1.0.0-beta.1",
  "description": "MonoGuard - Comprehensive monorepo architecture analysis and validation tool",
  "private": true,
  "packageManager": "pnpm@10.14.0",
  "scripts": {
    "build": "echo 'This is a monorepo - individual services should be built separately'",
    "start": "echo 'This is a monorepo - individual services should be started separately'",
    "build:all": "nx run-many --target=build --all",
    "dev": "nx dev",
    "dev:web": "nx dev web",
    "dev:cli": "nx dev cli",
    "lint": "nx run-many --target=lint --all",
    "lint:fix": "nx run-many --target=lint --all --fix",
    "test": "nx run-many --target=test --all",
    "test:watch": "nx run-many --target=test --all --watch",
    "test:coverage": "nx run-many --target=test --all --coverage",
    "test:e2e": "nx run-many --target=e2e --all",
    "test:e2e:p0": "pnpm exec playwright test --grep '@P0' --project=chromium",
    "test:e2e:p1": "pnpm exec playwright test --grep '@P0|@P1' --project=chromium",
    "test:e2e:burn-in": "bash scripts/burn-in.sh",
    "test:e2e:changed": "bash scripts/test-changed.sh",
    "ci:local": "bash scripts/ci-local.sh",
    "type-check": "nx run-many --target=type-check --all",
    "affected:build": "nx affected --target=build",
    "affected:test": "nx affected --target=test",
    "affected:lint": "nx affected --target=lint",
    "clean": "nx reset && pnpm clean:node-modules",
    "clean:node-modules": "pnpm -r exec rm -rf node_modules && rm -rf node_modules",
    "graph": "nx graph",
    "prepare": "husky",
    "format": "prettier --write \"**/*.{js,jsx,ts,tsx,json,md,yml,yaml}\"",
    "format:check": "prettier --check \"**/*.{js,jsx,ts,tsx,json,md,yml,yaml}\"",
    "biome:check": "biome check .",
    "biome:fix": "biome check --write .",
    "biome:format": "biome format --write .",
    "go:fmt": "find apps/api -name \"*.go\" -exec gofmt -s -w {} \\;",
    "go:vet": "cd apps/api && go vet ./...",
    "go:lint": "cd apps/api && golangci-lint run",
    "pre-commit": "lint-staged"
  },
  "keywords": [
    "monorepo",
    "architecture",
    "dependency-analysis",
    "security-scanning",
    "circular-dependencies",
    "typescript",
    "nextjs",
    "golang",
    "developer-tools",
    "code-quality"
  ],
  "author": "Alex Yu <alex@monoguard.dev>",
  "license": "Apache-2.0",
  "homepage": "https://monoguard-web.onrender.com",
  "repository": {
    "type": "git",
    "url": "https://github.com/j620656786206/MonoGuard.git"
  },
  "bugs": {
    "url": "https://github.com/alexyu/mono-guard/issues"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.11",
    "@eslint/compat": "^1.1.1",
    "@eslint/eslintrc": "^2.1.1",
    "@nx/devkit": "22.7.12",
    "@nx/eslint": "22.7.12",
    "@nx/eslint-plugin": "22.7.12",
    "@nx/js": "22.7.12",
    "@nx/playwright": "22.7.12",
    "@nx/workspace": "22.7.12",
    "@playwright/test": "^1.55.1",
    "@swc-node/register": "1.12.1",
    "@swc/core": "1.16.21",
    "@swc/helpers": "0.5.23",
    "@types/node": "24.3.0",
    "@types/react": "19.0.0",
    "@types/react-dom": "19.0.0",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "eslint": "^9.0.0",
    "eslint-config-prettier": "^10.0.0",
    "eslint-plugin-import": "2.31.0",
    "eslint-plugin-jsx-a11y": "6.10.1",
    "eslint-plugin-playwright": "^1.6.2",
    "eslint-plugin-react": "7.35.0",
    "eslint-plugin-react-hooks": "5.0.0",
    "husky": "^9.0.0",
    "lint-staged": "^15.0.0",
    "nx": "22.7.12",
    "prettier": "^3.2.0",
    "prettier-plugin-tailwindcss": "^0.6.0",
    "tslib": "^2.3.0",
    "typescript": "5.9.2"
  },
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*"
    ]
  },
  "engines": {
    "node": ">=18.0.0",
    "pnpm": ">=8.0.0"
  },
  "dependencies": {
    "react": "19.0.0",
    "react-dom": "19.0.0"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "biome check --write"
    ],
    "!(_bmad-output)/**/*.{json,md}": [
      "biome format --write"
    ],
    "!(_bmad-output)/**/*.{yml,yaml}": [
      "prettier --write"
    ],
    "apps/api/**/*.go": [
      "gofmt -s -w",
      "bash -c 'cd apps/api && go vet ./...'"
    ]
  },
  "pnpm": {
    "overrides": {
      "@babel/core@7": "^7.29.6",
      "@babel/plugin-transform-modules-systemjs@7": "^7.29.4",
      "@humanfs/node@0.16": "^0.16.8",
      "@tootallnate/once@2": "^2.0.1",
      "ajv@6": "^6.14.0",
      "ajv@8": "^8.18.0",
      "axios@1": "^1.20.0",
      "brace-expansion@1": "^1.1.21",
      "brace-expansion@2": "^2.1.7",
      "brace-expansion@5": "^5.0.12",
      "browserslist@4": "^4.28.7",
      "fast-uri@3": "^3.1.9",
      "flatted@3": "^3.4.2",
      "follow-redirects@1": "^1.16.2",
      "glob@10": "^10.5.0",
      "immutable@5": "^5.1.8",
      "js-yaml@3": "^3.15.2",
      "js-yaml@4": "^4.3.2",
      "minimatch@3": "^3.1.5",
      "minimatch@9": "^9.0.7",
      "picomatch@2": "^2.3.2",
      "picomatch@4": "^4.0.4",
      "postcss-selector-parser@6": "^6.1.5",
      "rollup@4": "^4.59.0",
      "serialize-javascript@<7.1.3": "^7.1.3",
      "smol-toml@1": "^1.9.0",
      "source-map-js@1": "^1.2.2",
      "webpack@5": "^5.104.1",
      "ws@8": "^8.21.0",
      "yaml@1": "^1.10.3",
      "yaml@2": "^2.8.3"
    }
  }
}
